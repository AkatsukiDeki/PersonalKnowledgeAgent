GEMINI_API_KEY=dummy

OLLAMA_EXTRACTION_MODEL=qwen2.5:7b
OLLAMA_QA_MODEL=qwen2.5-coder:14b
REASONING_PROVIDER=ollama

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b