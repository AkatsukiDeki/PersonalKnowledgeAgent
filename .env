# Database configuration
POSTGRES_USER=pka_user
POSTGRES_PASSWORD=pka_password
POSTGRES_DB=pka_db

# Backend configuration
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5434/${POSTGRES_DB}

# Optional features configuration
# OPENAI_API_KEY=your_openai_key_here
# GEMINI_API_KEY=your_gemini_key_here

OLLAMA_EXTRACTION_MODEL=qwen2.5:7b
OLLAMA_QA_MODEL=qwen2.5-coder:14b
REASONING_PROVIDER=ollama
