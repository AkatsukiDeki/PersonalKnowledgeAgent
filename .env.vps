# Database configuration
POSTGRES_USER=pka_user
POSTGRES_PASSWORD=pka_secret_password
POSTGRES_DB=pka_db

# Backend DB connection
DATABASE_URL=postgresql+asyncpg://pka_user:pka_secret_password@db:5432/pka_db

# Ollama Host & Fast Models
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EXTRACTION_MODEL=qwen2.5:3b
OLLAMA_QA_MODEL=qwen2.5:3b
REASONING_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
LLM_ROUTING_BACKEND=local
PKA_LLM_MAX_CONCURRENCY=3

# Whisper STT Engine
PKA_WHISPER_MODEL=small
PKA_WHISPER_DEVICE=cpu
PKA_WHISPER_COMPUTE_TYPE=int8

# Optional API Keys & CORS
GEMINI_API_KEY=
CORS_ORIGINS=*

# Bot configuration
TG_BOT_TOKEN=8600481575:AAGUaZmkiVc8y8whyIm2MYCvXgK79vqh6iY
TG_ALLOWED_USERS=
BACKEND_API_URL=http://backend:8000/api/v1