# .env.vps - Template for VPS Deployment
# Copy this file to .env on the VPS

# PostgreSQL settings
POSTGRES_USER=pka_user
POSTGRES_PASSWORD=pka_secret_password
POSTGRES_DB=pka_db

# Tailscale / WireGuard IP of the local PC running Ollama
# Replace 100.x.x.x with your actual Tailscale IP (e.g. 100.80.15.42)
OLLAMA_BASE_URL=http://100.x.x.x:11434

# General Backend Settings
EMBEDDING_PROVIDER=ollama
# Optional: Set this to your actual domain name for better security in production
CORS_ORIGINS=*
